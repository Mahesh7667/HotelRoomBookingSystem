@HotelRoomBooking_HostAddress = http://localhost:5232

# Get all hotels
GET {{HotelRoomBooking_HostAddress}}/api/hotels/all
Accept: application/json

###

# Get hotel by name
GET {{HotelRoomBooking_HostAddress}}/api/hotels?name=Sample%20Hotel
Accept: application/json

###

# Get available rooms
GET {{HotelRoomBooking_HostAddress}}/api/rooms/available?checkIn=2025-09-15&checkOut=2025-09-16&guests=2
Accept: application/json

###

# Create booking
POST {{HotelRoomBooking_HostAddress}}/api/bookings
Content-Type: application/json

{
  "roomId": 3,
  "customerName": "John Doe",
  "checkIn": "2025-09-15",
  "checkOut": "2025-09-16",
  "numberOfGuests": 2
}

###

# Get booking by reference (use the reference returned from create booking)
GET {{HotelRoomBooking_HostAddress}}/api/bookings/{reference}
Accept: application/json

###

# Reset bookings data
POST {{HotelRoomBooking_HostAddress}}/api/data/reset
Content-Type: application/json

###
